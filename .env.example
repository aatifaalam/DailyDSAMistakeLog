# ==============================================================================
# Daily DSA Mistake Log - Environment Variables Template
# Copy this file to .env and customize with your own secrets.
# NEVER commit your actual .env file or real secrets to Git!
# ==============================================================================

# Database Configuration (MySQL 8.x)
DB_URL=jdbc:mysql://localhost:3306/dsa_mistake_log?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# Spring Boot Server Port
SERVER_PORT=8080

# CORS Allowed Origin
# Restrict to your frontend application's origin in development and production
FRONTEND_ORIGIN=http://localhost:5173

# JWT Security Configuration
# JWT_SECRET: Must be a secret of at least 256 bits (32 bytes / 64 hex characters)
# required for HMAC-SHA256 (HS256) signing.
# You can generate a random 256-bit hex secret using: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_SECONDS=86400

# Migration Owner Email
# Designates the account that owns legacy unassigned mistake records
MIGRATION_OWNER_EMAIL=system@dsamistakelog.com

# Seeding Configuration
APP_SEED_DATA_ENABLED=true
